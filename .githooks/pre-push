#!/usr/bin/env bash
# Safety net for the pre-commit hook: inspect only the objects that would be
# sent by this push, including commits made before the hook was installed.
#
# Bypass: `git push --no-verify` or `ALLOW_LARGE_FILES=1 git push ...`
# GitHub still enforces the 100 MiB limit server-side.

set -euo pipefail

limit=${LARGE_FILE_LIMIT:-$((100 * 1024 * 1024))} # 100 MiB: GitHub hard limit
warn=${LARGE_FILE_WARN:-$((50 * 1024 * 1024))}    # 50 MiB: GitHub warning

if [[ ${ALLOW_LARGE_FILES:-0} == 1 ]]; then
  exit 0
fi

remote=${1:-origin}

human() { printf '%6.1f MiB' "$(awk -v n="$1" 'BEGIN { print n / 1048576 }')"; }

check_range() {
  local out
  if ! out=$(git rev-list --objects "$@" |
    git cat-file --batch-check='%(objecttype) %(objectsize) %(rest)' |
    awk -v limit="$limit" -v warn="$warn" '
      $1 == "blob" {
        size = $2 + 0
        path = $0
        sub(/^[^ ]+ [^ ]+ /, "", path)
        if (size >= limit)      printf "BLOCK|%d|%s\n", size, path
        else if (size >= warn)  printf "WARN|%d|%s\n", size, path
      }'); then
    echo "pre-push: unable to inspect the objects being pushed" >&2
    return 2
  fi

  [[ -n $out ]] || return 0

  local kind size path
  while IFS='|' read -r kind size path; do
    if [[ $kind == BLOCK ]]; then
      printf '  x %s  %s\n' "$(human "$size")" "$path" >&2
    else
      printf '  ! %s  %s (GitHub warns above 50 MiB)\n' "$(human "$size")" "$path" >&2
    fi
  done <<<"$out"

  [[ $out != *'BLOCK|'* ]]
}

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n ${local_sha:-} ]] || continue
  [[ $local_sha =~ ^0+$ ]] && continue # branch/tag deletion

  if [[ $remote_sha =~ ^0+$ ]]; then
    # New ref: every object not already reachable from a remote-tracking ref.
    if ! check_range "$local_sha" --not "--remotes=$remote"; then
      blocked=1
    fi
  else
    # Existing ref: only additions compared with the remote tip.
    if ! check_range "$remote_sha..$local_sha"; then
      blocked=1
    fi
  fi
done

if ((blocked)); then
  cat >&2 <<'EOF'

Push blocked: one or more commits contain a file at or above GitHub's 100 MiB limit.

The file is already in history, so editing .gitignore or deleting it in a new
commit is not enough. You need to rewrite the offending commit(s) before pushing:

  git log --oneline @{push}..HEAD        # find the commit that introduced it
  git rebase -i @{push}                  # edit/restore that commit, then continue
  # or use git-filter-repo / BFG to purge the blob from history

Alternatives if the file must be distributed: Git LFS, or a GitHub release asset.

To bypass this hook intentionally: ALLOW_LARGE_FILES=1 git push ...
EOF
  exit 1
fi
